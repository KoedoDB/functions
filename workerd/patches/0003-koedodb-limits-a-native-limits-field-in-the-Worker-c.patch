From 3c026d9f30c7b574157c1eeb7aef19bcfb3f9f9c Mon Sep 17 00:00:00 2001
From: banil246 <igoigo246@gmail.com>
Date: Sun, 18 Oct 2026 05:39:58 +0900
Subject: [PATCH 3/3] koedodb limits: a native 'limits' field in the Worker
 config

Worker.limits (workerd.capnp) carries cpuMs, wallMs, heapMb, externalMb, subrequests and
concurrentSubrequests; the Rust server reads it into WorkerSpec (bridge.rs, worker.rs) and the factory hands it
to the isolate enforcer. The WORKERD_KOEDODB_LIMITS table still works and applies to Workers whose config has no
limits (dynamic workers have none in their config).
---
 src/workerd/server/factory/koedodb-limits.c++ |  4 +--
 src/workerd/server/factory/koedodb-limits.h   |  5 +++-
 src/workerd/server/factory/worker-factory.c++ |  8 +++++-
 src/workerd/server/server/bridge.rs           | 13 +++++++++
 src/workerd/server/server/worker.rs           | 14 ++++++++++
 src/workerd/server/workerd.capnp              | 27 +++++++++++++++++++
 6 files changed, 67 insertions(+), 4 deletions(-)

diff --git a/src/workerd/server/factory/koedodb-limits.c++ b/src/workerd/server/factory/koedodb-limits.c++
index 0f28a4c08..9b6a33cea 100644
--- a/src/workerd/server/factory/koedodb-limits.c++
+++ b/src/workerd/server/factory/koedodb-limits.c++
@@ -698,8 +698,8 @@ WorkerLimits limitsFor(kj::StringPtr name) {
 }
 
 kj::Maybe<kj::Own<IsolateLimitEnforcer>> newIsolateLimitEnforcer(
-    kj::StringPtr name, v8::IsolateGroup group) {
-  auto limits = limitsFor(name);
+    kj::StringPtr name, v8::IsolateGroup group, WorkerLimits configured) {
+  auto limits = configured.any() ? configured : limitsFor(name);
   if (!limits.any()) return kj::none;
   auto state = std::make_shared<WorkerState>();
   state->name = name.cStr();
diff --git a/src/workerd/server/factory/koedodb-limits.h b/src/workerd/server/factory/koedodb-limits.h
index 687683b7c..2f0560d61 100644
--- a/src/workerd/server/factory/koedodb-limits.h
+++ b/src/workerd/server/factory/koedodb-limits.h
@@ -50,8 +50,11 @@ WorkerLimits limitsFor(kj::StringPtr name);
 // The enforcer of one isolate (one Worker); none when the Worker has no limits (the caller then keeps
 // the "no limits" enforcer). Also creates the per-Worker state that the per-request enforcers made by
 // newRequestLimitEnforcer() share.
+//
+// `configured` are the limits of the Worker's `limits` field in the config; when they are all zero the
+// WORKERD_KOEDODB_LIMITS table decides.
 kj::Maybe<kj::Own<IsolateLimitEnforcer>> newIsolateLimitEnforcer(
-    kj::StringPtr name, v8::IsolateGroup group);
+    kj::StringPtr name, v8::IsolateGroup group, WorkerLimits configured = {});
 
 // The enforcer of one request (one IoContext) of the Worker called `name`; none when the Worker has
 // no limits.
diff --git a/src/workerd/server/factory/worker-factory.c++ b/src/workerd/server/factory/worker-factory.c++
index f5dfff14b..f755b513e 100644
--- a/src/workerd/server/factory/worker-factory.c++
+++ b/src/workerd/server/factory/worker-factory.c++
@@ -1610,7 +1610,13 @@ kj::Promise<kj::Own<CompiledWorker>> factory_new_worker(const WorkerFactory& con
                          kj::Maybe<jsg::SnapshotConfig> snapshotConfig) {
     auto group = jsg::newIsolateGroup();
     kj::Own<IsolateLimitEnforcer> limitEnforcer = kj::refcounted<NullIsolateLimitEnforcer>();
-    KJ_IF_SOME(enforcer, koedodb::newIsolateLimitEnforcer(isolateName, group)) {
+    koedodb::WorkerLimits configuredLimits{.cpuMs = spec.limits.cpu_ms,
+      .wallMs = spec.limits.wall_ms,
+      .heapMb = spec.limits.heap_mb,
+      .externalMb = spec.limits.external_mb,
+      .subrequests = spec.limits.subrequests,
+      .concurrentSubrequests = spec.limits.concurrent_subrequests};
+    KJ_IF_SOME(enforcer, koedodb::newIsolateLimitEnforcer(isolateName, group, configuredLimits)) {
       limitEnforcer = kj::mv(enforcer);
     }
     auto listeners = KJ_MAP(listener, spec.inbound_listeners) {
diff --git a/src/workerd/server/server/bridge.rs b/src/workerd/server/server/bridge.rs
index 20de6a144..1c12ea770 100644
--- a/src/workerd/server/server/bridge.rs
+++ b/src/workerd/server/server/bridge.rs
@@ -115,6 +115,19 @@ pub mod ffi {
         /// `accessBlobHeader`, when set: requests carrying this header have it parsed into the
         /// request's access info.
         access_blob_header: KjMaybe<String>,
+        /// The Worker's `limits` (all zero: none), for the per-Worker enforcers of koedodb-limits.h.
+        limits: WorkerLimitsSpec,
+    }
+
+    /// `Worker.limits` of the config; 0 means no limit.
+    #[derive(Default)]
+    struct WorkerLimitsSpec {
+        cpu_ms: u32,
+        wall_ms: u32,
+        heap_mb: u32,
+        external_mb: u32,
+        subrequests: u32,
+        concurrent_subrequests: u32,
     }
 
     /// A header the rewriter sets to `value`, or removes when it has none. `name` is a header
diff --git a/src/workerd/server/server/worker.rs b/src/workerd/server/server/worker.rs
index 73bbf9745..00c765dd7 100644
--- a/src/workerd/server/server/worker.rs
+++ b/src/workerd/server/server/worker.rs
@@ -180,6 +180,19 @@ impl WorkerService {
             inbound_listeners,
             globals: std::mem::take(&mut bindings.globals),
             access_blob_header: access_blob_header.into(),
+            limits: if conf.has_limits() {
+                let l = conf.get_limits().map_err(capnp_error)?;
+                ffi::WorkerLimitsSpec {
+                    cpu_ms: l.get_cpu_ms(),
+                    wall_ms: l.get_wall_ms(),
+                    heap_mb: l.get_heap_mb(),
+                    external_mb: l.get_external_mb(),
+                    subrequests: l.get_subrequests(),
+                    concurrent_subrequests: l.get_concurrent_subrequests(),
+                }
+            } else {
+                ffi::WorkerLimitsSpec::default()
+            },
         };
         let compiled = ffi::factory_new_worker(
             factory.raw(),
@@ -276,6 +289,7 @@ impl WorkerService {
             inbound_listeners: Vec::new(),
             globals: Vec::new(),
             access_blob_header: KjMaybe::None,
+            limits: ffi::WorkerLimitsSpec::default(),
         };
         let compiled =
             ffi::factory_new_worker(factory.raw(), &spec, KjMaybe::None, KjMaybe::Some(source))
diff --git a/src/workerd/server/workerd.capnp b/src/workerd/server/workerd.capnp
index 63457f661..de53e6a44 100644
--- a/src/workerd/server/workerd.capnp
+++ b/src/workerd/server/workerd.capnp
@@ -948,6 +948,33 @@ struct Worker {
 
   workflowsEngine @20 :WorkflowsEngine;
   # the externally-supplied service responsible for running Workflows defined in this worker
+
+  limits @21 :Limits;
+  # KoedoDB: resource limits of this Worker, so that it cannot stop the other Workers of the process.
+  # Without this field (and without an entry in WORKERD_KOEDODB_LIMITS) the Worker has no limits, as in
+  # upstream workerd. See src/workerd/server/factory/koedodb-limits.h.
+
+  struct Limits {
+    cpuMs @0 :UInt32;
+    # CPU time (thread CPU clock) one request may use, summed over the runs of JavaScript it causes.
+    # 0 = no limit.
+
+    wallMs @1 :UInt32;
+    # Wall-clock time one request may take, including waiting for subrequests. 0 = no limit.
+
+    heapMb @2 :UInt32;
+    # Limit of the V8 old generation of this Worker's isolate, in MB. 0 = no limit.
+
+    externalMb @3 :UInt32;
+    # Limit of ArrayBuffer / typed array / WebAssembly memory of this Worker's isolate, in MB.
+    # 0 = no limit.
+
+    subrequests @4 :UInt32;
+    # Subrequests (fetch, WebSocket, cache) one request may start. 0 = no limit.
+
+    concurrentSubrequests @5 :UInt32;
+    # Subrequests the Worker may have open at once, over all its requests. 0 = no limit.
+  }
 }
 
 struct ExternalServer {
