+// ---------------------------------------------------------------------------------------------
+// Limits from the environment.
+
+WorkerLimits parseLimitSet(const std::string& spec) {
+  WorkerLimits l;
+  std::stringstream ss(spec);
+  std::string item;
+  while (std::getline(ss, item, ',')) {
+    auto colon = item.find(':');
+    if (colon == std::string::npos) continue;
+    std::string key = item.substr(0, colon);
+    uint32_t value = static_cast<uint32_t>(std::strtoul(item.c_str() + colon + 1, nullptr, 10));
+    // Trim spaces of the key.
+    while (!key.empty() && key.front() == ' ') key.erase(key.begin());
+    while (!key.empty() && key.back() == ' ') key.pop_back();
+    if (key == "cpu") l.cpuMs = value;
+    else if (key == "wall") l.wallMs = value;
+    else if (key == "heap") l.heapMb = value;
+    else if (key == "ext") l.externalMb = value;
+    else if (key == "sub") l.subrequests = value;
+  }
+  return l;
+}
+
+struct LimitTable {
+  std::map<std::string, WorkerLimits> byName;
+  WorkerLimits fallback;
+  bool hasFallback = false;
+};
+
+LimitTable loadTable() {
+  std::string text;
+  if (const char* file = std::getenv("WORKERD_KOEDODB_LIMITS_FILE")) {
+    std::ifstream in(file);
+    std::stringstream buf;
+    buf << in.rdbuf();
+    text = buf.str();
+  } else if (const char* env = std::getenv("WORKERD_KOEDODB_LIMITS")) {
+    text = env;
+  }
+  LimitTable table;
+  for (char& c: text) {
+    if (c == '\n' || c == '\r') c = ';';
+  }
+  std::stringstream ss(text);
+  std::string entry;
+  while (std::getline(ss, entry, ';')) {
+    auto eq = entry.find('=');
+    if (eq == std::string::npos) continue;
+    std::string name = entry.substr(0, eq);
+    while (!name.empty() && name.front() == ' ') name.erase(name.begin());
+    while (!name.empty() && name.back() == ' ') name.pop_back();
+    WorkerLimits limits = parseLimitSet(entry.substr(eq + 1));
+    if (name == "*") {
+      table.fallback = limits;
+      table.hasFallback = true;
+    } else {
+      table.byName[name] = limits;
+    }
+  }
+  return table;
+}
+
+const LimitTable& table() {
+  static const LimitTable t = loadTable();
+  return t;
+}
