+// ---------------------------------------------------------------------------------------------
+// The per-request enforcer.
+
+class RequestEnforcer final: public LimitEnforcer, public kj::Refcounted, public Target {
+ public:
+  explicit RequestEnforcer(std::shared_ptr<WorkerState> state)
+      : state(std::move(state)),
+        cpuBudgetNs(int64_t(this->state->limits.cpuMs) * 1'000'000) {
+    auto pair = kj::newPromiseAndCrossThreadFulfiller<void>();
+    exceededPromise = pair.promise.fork();
+    fulfiller = kj::mv(pair.fulfiller);
+    if (this->state->limits.wallMs != 0) {
+      wallHandle = Watchdog::get().addWall(
+          this, std::chrono::milliseconds(this->state->limits.wallMs));
+    }
+  }
+
+  ~RequestEnforcer() noexcept(false) {
+    KJ_IF_SOME(h, wallHandle) {
+      Watchdog::get().removeWall(h);
+    }
+    // Do not leave the abort promise rejected-by-destruction: that would abort a request that
+    // is only finishing.
+    if (!fulfilled.exchange(true)) fulfiller->fulfill();
+  }
+
+  // --- Target (watchdog thread)
+  void cpuExceeded() override {
+    mark(Exceeded::CPU);
+  }
+  void wallExceeded() override {
+    mark(Exceeded::WALL);
+  }
+  void memoryExceeded() {
+    mark(Exceeded::MEMORY);
+  }
+
+  // --- LimitEnforcer
+  kj::Own<void> enterJs(jsg::Lock& lock, IoContext& context) override;
+
+  void topUpActor() override {}
+
+  void newSubrequest(bool isInHouse) override {
+    if (isInHouse || state->limits.subrequests == 0) return;
+    if (++subrequestCount > state->limits.subrequests) {
+      JSG_FAIL_REQUIRE(Error, "Too many subrequests.");
+    }
+  }
+  void newKvRequest(KvOpType op) override {}
+  void newAnalyticsEngineRequest() override {}
+  kj::Promise<void> limitDrain() override {
+    return kj::NEVER_DONE;
+  }
+  kj::Promise<void> limitScheduled() override {
+    return kj::NEVER_DONE;
+  }
+  kj::Duration getAlarmLimit() override {
+    return 15 * kj::MINUTES;
+  }
+  size_t getBufferingLimit() override {
+    return state->limits.externalMb != 0 ? size_t(state->limits.externalMb) << 20 : kj::maxValue;
+  }
+  kj::Maybe<EventOutcome> getLimitsExceeded() override {
+    return outcomeOf(Exceeded(exceeded.load()));
+  }
+  kj::Promise<void> onLimitsExceeded() override {
+    return exceededPromise.addBranch();
+  }
+  void setCpuLimitNearlyExceededCallback(kj::Function<void(void)> cb) override {}
+  void requireLimitsNotExceeded() override {
+    auto kind = Exceeded(exceeded.load());
+    if (kind != Exceeded::NONE) kj::throwFatalException(makeExceeded(kind));
+  }
+  void reportMetrics(RequestObserver& requestMetrics) override {}
+  kj::Duration consumeTimeElapsedForPeriodicLogging() override {
+    return 0 * kj::SECONDS;
+  }
+  size_t getSqliteMemoryUsage() const override {
+    return 0;
+  }
+
+  bool hasExceeded() const {
+    return exceeded.load() != int(Exceeded::NONE);
+  }
+
+  WorkerState& workerState() {
+    return *state;
+  }
+  int64_t cpuBudgetRemainingNs() const {
+    return cpuBudgetNs - cpuUsedNs.load();
+  }
+  void addCpuUsed(int64_t ns) {
+    cpuUsedNs.fetch_add(ns);
+  }
+  bool hasCpuLimit() const {
+    return state->limits.cpuMs != 0;
+  }
+  kj::Maybe<Watchdog::WallHandle>& wall() {
+    return wallHandle;
+  }
+
+ private:
+  void mark(Exceeded kind) {
+    int expected = int(Exceeded::NONE);
+    if (exceeded.compare_exchange_strong(expected, int(kind))) {
+      if (!fulfilled.exchange(true)) fulfiller->reject(makeExceeded(kind));
+    }
+  }
+
+  std::shared_ptr<WorkerState> state;
+  int64_t cpuBudgetNs;
+  std::atomic<int64_t> cpuUsedNs{0};
+  std::atomic<int> exceeded{int(Exceeded::NONE)};
+  std::atomic<bool> fulfilled{false};
+  std::atomic<uint32_t> subrequestCount{0};
+  kj::Own<kj::CrossThreadPromiseFulfiller<void>> fulfiller;
+  kj::ForkedPromise<void> exceededPromise{nullptr};
+  kj::Maybe<Watchdog::WallHandle> wallHandle;
+};
+
+// The scope of one run of JavaScript of a request.
+class JsScope final {
+ public:
+  JsScope(RequestEnforcer& enforcer, v8::Isolate* isolate): enforcer(enforcer), isolate(isolate) {
+    auto& st = enforcer.workerState();
+    previousRunning = st.running.exchange(&enforcer);
+    if (enforcer.hasCpuLimit()) {
+      pthread_getcpuclockid(pthread_self(), &clock);
+      startNs = cpuNowNs(clock);
+      int64_t remaining = enforcer.cpuBudgetRemainingNs();
+      cpuHandle = Watchdog::get().addCpu(isolate, clock, startNs + (remaining > 0 ? remaining : 0),
+          &enforcer);
+    }
+    KJ_IF_SOME(w, enforcer.wall()) {
+      Watchdog::get().setWallRunning(w, isolate);
+    }
+  }
+
+  ~JsScope() noexcept(false) {
+    KJ_IF_SOME(w, enforcer.wall()) {
+      Watchdog::get().setWallRunning(w, nullptr);
+    }
+    bool terminatedByUs = enforcer.hasExceeded();
+    KJ_IF_SOME(h, cpuHandle) {
+      Watchdog::get().removeCpu(h);
+      enforcer.addCpuUsed(cpuNowNs(clock) - startNs);
+    }
+    enforcer.workerState().running.store(previousRunning);
+    // JavaScript has stopped: resume the isolate for the next request, if it was we who ended it.
+    if (terminatedByUs && isolate->IsExecutionTerminating()) {
+      isolate->CancelTerminateExecution();
+    }
+  }
+
+  KJ_DISALLOW_COPY_AND_MOVE(JsScope);
+
+ private:
+  RequestEnforcer& enforcer;
+  v8::Isolate* isolate;
+  RequestEnforcer* previousRunning = nullptr;
+  clockid_t clock = CLOCK_THREAD_CPUTIME_ID;
+  int64_t startNs = 0;
+  kj::Maybe<Watchdog::CpuHandle> cpuHandle;
+};
+
+kj::Own<void> RequestEnforcer::enterJs(jsg::Lock& lock, IoContext& context) {
+  return kj::heap<JsScope>(*this, lock.v8Isolate);
+}
