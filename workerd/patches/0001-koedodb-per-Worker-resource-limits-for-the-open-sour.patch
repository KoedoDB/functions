+// ---------------------------------------------------------------------------------------------
+// The per-isolate enforcer.
+
+// A scope for startup (module evaluation) and the like, with its own CPU budget and no request.
+class StartupTarget final: public Target {
+ public:
+  void cpuExceeded() override {
+    hit.store(true);
+  }
+  void wallExceeded() override {}
+  std::atomic<bool> hit{false};
+};
+
+class StartupScope final {
+ public:
+  StartupScope(v8::Isolate* isolate,
+      uint32_t budgetMs,
+      kj::OneOf<kj::Exception, kj::Duration>& out)
+      : isolate(isolate),
+        out(out) {
+    if (budgetMs != 0) {
+      pthread_getcpuclockid(pthread_self(), &clock);
+      startNs = cpuNowNs(clock);
+      handle = Watchdog::get().addCpu(isolate, clock, startNs + int64_t(budgetMs) * 1'000'000,
+          &target);
+    }
+  }
+  ~StartupScope() noexcept(false) {
+    KJ_IF_SOME(h, handle) {
+      Watchdog::get().removeCpu(h);
+    }
+    if (target.hit.load()) {
+      out = makeExceeded(Exceeded::CPU);
+      if (isolate->IsExecutionTerminating()) isolate->CancelTerminateExecution();
+    }
+  }
+  KJ_DISALLOW_COPY_AND_MOVE(StartupScope);
+
+ private:
+  v8::Isolate* isolate;
+  kj::OneOf<kj::Exception, kj::Duration>& out;
+  StartupTarget target;
+  clockid_t clock = CLOCK_THREAD_CPUTIME_ID;
+  int64_t startNs = 0;
+  kj::Maybe<Watchdog::CpuHandle> handle;
+};
+
+size_t nearHeapLimit(void* data, size_t currentLimit, size_t initialLimit) {
+  auto* st = static_cast<WorkerState*>(data);
+  // V8 also calls this when an ArrayBuffer allocation was refused and its last-resort garbage collection
+  // found nothing to free, although the JavaScript heap itself is far from full: then the tenant must
+  // get the RangeError (which it can catch) and not lose its request.
+  if (auto* iso = st->isolate.load()) {
+    v8::HeapStatistics stats;
+    iso->GetHeapStatistics(&stats);
+    if (stats.used_heap_size() < currentLimit / 100 * 80) return currentLimit + (8u << 20);
+  }
+  st->heapHits.fetch_add(1);
+  fprintf(stderr, "koedodb-limits: heap limit of %s reached: limit %zu MB, hits %u\n", st->name.c_str(),
+      currentLimit >> 20, st->heapHits.load());
+  if (auto* running = st->running.load()) running->memoryExceeded();
+  if (auto* iso = st->isolate.load()) iso->TerminateExecution();
+  // Room to unwind and for the garbage collector to finish; the heap shrinks again once the
+  // request that filled it is gone.
+  return currentLimit + (16u << 20);
+}
+
+class IsolateEnforcer final: public IsolateLimitEnforcer {
+ public:
+  IsolateEnforcer(std::shared_ptr<WorkerState> state, v8::IsolateGroup group)
+      : state(std::move(state)),
+        group(group) {}
+
+  v8::Isolate::CreateParams getCreateParams() override {
+    v8::Isolate::CreateParams params;
+    const auto& limits = state->limits;
+    if (limits.heapMb != 0) {
+      params.constraints.set_max_old_generation_size_in_bytes(size_t(limits.heapMb) << 20);
+    }
+    if (limits.externalMb != 0) {
+#ifdef V8_COMPRESS_POINTERS_IN_MULTIPLE_CAGES
+      std::unique_ptr<v8::ArrayBuffer::Allocator> inner(
+          v8::ArrayBuffer::Allocator::NewDefaultAllocator(group));
+#else
+      std::unique_ptr<v8::ArrayBuffer::Allocator> inner(
+          v8::ArrayBuffer::Allocator::NewDefaultAllocator());
+#endif
+      state->allocator = std::make_shared<CountingAllocator>(
+          std::move(inner), size_t(limits.externalMb) << 20);
+      params.array_buffer_allocator_shared = state->allocator;
+    }
+    return params;
+  }
+
+  void customizeIsolate(v8::Isolate* isolate) override {
+    state->isolate.store(isolate);
+    if (state->limits.heapMb != 0) {
+      isolate->AddNearHeapLimitCallback(&nearHeapLimit, state.get());
+    }
+  }
+
+  ActorCacheSharedLruOptions getActorCacheLruOptions() override {
+    return {.softLimit = 16 * (1ull << 20),
+      .hardLimit = 128 * (1ull << 20),
+      .staleTimeout = 30 * kj::SECONDS,
+      .dirtyListByteLimit = 8 * (1ull << 20),
+      .maxKeysPerRpc = 128,
+      .neverFlush = true};
+  }
+
+  kj::Own<void> enterStartupJs(
+      jsg::Lock& lock, kj::OneOf<kj::Exception, kj::Duration>& limitErrorOrTime) const override {
+    return startupScope(lock, limitErrorOrTime);
+  }
+  kj::Own<void> enterStartupPython(
+      jsg::Lock& lock, kj::OneOf<kj::Exception, kj::Duration>& limitErrorOrTime) const override {
+    return startupScope(lock, limitErrorOrTime);
+  }
+  kj::Own<void> enterDynamicImportJs(
+      jsg::Lock& lock, kj::OneOf<kj::Exception, kj::Duration>& limitErrorOrTime) const override {
+    return startupScope(lock, limitErrorOrTime);
+  }
+  kj::Own<void> enterLoggingJs(
+      jsg::Lock& lock, kj::OneOf<kj::Exception, kj::Duration>& limitErrorOrTime) const override {
+    return startupScope(lock, limitErrorOrTime);
+  }
+  kj::Own<void> enterInspectorJs(
+      jsg::Lock& lock, kj::OneOf<kj::Exception, kj::Duration>& limitErrorOrTime) const override {
+    return startupScope(lock, limitErrorOrTime);
+  }
+
+  void completedRequest(kj::StringPtr id) const override {}
+
+  bool exitJs(jsg::Lock& lock) const override {
+    return false;
+  }
+
+  void reportMetrics(IsolateObserver& isolateMetrics) const override {}
+
+  kj::Maybe<size_t> checkPbkdfIterations(jsg::Lock& lock, size_t iterations) const override {
+    return kj::none;
+  }
+
+  bool hasExcessivelyExceededHeapLimit() const override {
+    return state->heapHits.load() >= 4;
+  }
+
+  const TrackedWasmInstanceList& getTrackedWasmInstances() const override {
+    return trackedWasmInstances;
+  }
+
+ private:
+  kj::Own<void> startupScope(
+      jsg::Lock& lock, kj::OneOf<kj::Exception, kj::Duration>& out) const {
+    // Startup runs the bundle's top-level code: give it more than a request gets.
+    uint32_t cpuMs = state->limits.cpuMs;
+    uint32_t budget = cpuMs == 0 ? 0 : std::max<uint32_t>(cpuMs * 5, 1000);
+    return kj::heap<StartupScope>(lock.v8Isolate, budget, out);
+  }
+
+  std::shared_ptr<WorkerState> state;
+  v8::IsolateGroup group;
+  TrackedWasmInstanceList trackedWasmInstances;
+};
+
+}  // namespace
+
+WorkerLimits limitsFor(kj::StringPtr name) {
+  const auto& t = table();
+  auto it = t.byName.find(std::string(name.cStr()));
+  if (it != t.byName.end()) return it->second;
+  if (t.hasFallback) return t.fallback;
+  return {};
+}
+
+kj::Maybe<kj::Own<IsolateLimitEnforcer>> newIsolateLimitEnforcer(
+    kj::StringPtr name, v8::IsolateGroup group) {
+  auto limits = limitsFor(name);
+  if (!limits.any()) return kj::none;
+  auto state = std::make_shared<WorkerState>();
+  state->name = name.cStr();
+  state->limits = limits;
+  {
+    std::lock_guard<std::mutex> lk(registryMutex);
+    registry()[state->name] = state;
+  }
+  return kj::Own<IsolateLimitEnforcer>(kj::refcounted<IsolateEnforcer>(std::move(state), group));
+}
+
+kj::Maybe<kj::Own<LimitEnforcer>> newRequestLimitEnforcer(kj::StringPtr name) {
+  auto state = findState(name);
+  if (state == nullptr) return kj::none;
+  return kj::Own<LimitEnforcer>(kj::refcounted<RequestEnforcer>(std::move(state)));
+}
+
+}  // namespace workerd::server::koedodb
