+// ---------------------------------------------------------------------------------------------
+// ArrayBuffer memory of one isolate, counted, with a cap.
+
+class CountingAllocator final: public v8::ArrayBuffer::Allocator {
+ public:
+  CountingAllocator(std::unique_ptr<v8::ArrayBuffer::Allocator> inner, size_t cap)
+      : inner(std::move(inner)),
+        cap(cap) {}
+
+  void* Allocate(size_t length) override {
+    if (!reserve(length)) return nullptr;
+    void* p = inner->Allocate(length);
+    if (p == nullptr) release(length);
+    return p;
+  }
+  void* AllocateUninitialized(size_t length) override {
+    if (!reserve(length)) return nullptr;
+    void* p = inner->AllocateUninitialized(length);
+    if (p == nullptr) release(length);
+    return p;
+  }
+  void Free(void* data, size_t length) override {
+    inner->Free(data, length);
+    release(length);
+  }
+
+  size_t used() const {
+    return usedBytes.load(std::memory_order_relaxed);
+  }
+  uint64_t refusals() const {
+    return refused.load(std::memory_order_relaxed);
+  }
+
+ private:
+  bool reserve(size_t n) {
+    size_t cur = usedBytes.load(std::memory_order_relaxed);
+    for (;;) {
+      if (cap != 0 && (n > cap || cur > cap - n)) {
+        uint64_t count = refused.fetch_add(1, std::memory_order_relaxed) + 1;
+        // Log the 1st, 2nd, 4th, 8th ... refusal: a tenant in a loop must not flood the log.
+        if ((count & (count - 1)) == 0) {
+          fprintf(stderr, "koedodb-limits: ArrayBuffer allocation of %zu bytes refused (used %zu, cap %zu, refusal #%llu)\n",
+              n, cur, cap, (unsigned long long)count);
+        }
+        return false;
+      }
+      if (usedBytes.compare_exchange_weak(cur, cur + n, std::memory_order_relaxed)) return true;
+    }
+  }
+  void release(size_t n) {
+    usedBytes.fetch_sub(n, std::memory_order_relaxed);
+  }
+
+  std::unique_ptr<v8::ArrayBuffer::Allocator> inner;
+  size_t cap;
+  std::atomic<size_t> usedBytes{0};
+  std::atomic<uint64_t> refused{0};
+};
+
+// ---------------------------------------------------------------------------------------------
+// The watchdog: one thread that ends JavaScript which runs over its CPU budget or whose request
+// is over its wall-clock budget.
+
+// Who is told when a budget is used up. Implemented by the per-request enforcer and by the
+// startup scopes. Called on the watchdog thread with the watchdog's mutex held: keep it short.
+class Target {
+ public:
+  virtual void cpuExceeded() = 0;
+  virtual void wallExceeded() = 0;
+};
+
+int64_t cpuNowNs(clockid_t clock) {
+  timespec ts;
+  if (clock_gettime(clock, &ts) != 0) return 0;
+  return int64_t(ts.tv_sec) * 1'000'000'000 + ts.tv_nsec;
+}
+
+class Watchdog {
+ public:
+  struct CpuEntry {
+    v8::Isolate* isolate;
+    clockid_t clock;
+    int64_t deadlineNs;  // absolute, on `clock`
+    Target* target;
+    bool fired = false;
+  };
+  struct WallEntry {
+    Target* target;
+    std::chrono::steady_clock::time_point deadline;
+    // The JS scope of the request that is running now, so that JS can be ended; null if none.
+    CpuEntry* running = nullptr;
+    v8::Isolate* isolate = nullptr;
+    bool fired = false;
+  };
+
+  static Watchdog& get() {
+    static Watchdog* w = new Watchdog();  // never destroyed: the thread outlives static teardown
+    return *w;
+  }
+
+  using CpuHandle = std::list<CpuEntry>::iterator;
+  using WallHandle = std::list<WallEntry>::iterator;
+
+  CpuHandle addCpu(v8::Isolate* isolate, clockid_t clock, int64_t deadlineNs, Target* target) {
+    std::lock_guard<std::mutex> lk(mu);
+    cpu.push_back(CpuEntry{isolate, clock, deadlineNs, target});
+    auto it = std::prev(cpu.end());
+    cv.notify_one();
+    return it;
+  }
+  bool removeCpu(CpuHandle it) {
+    std::lock_guard<std::mutex> lk(mu);
+    bool fired = it->fired;
+    cpu.erase(it);
+    return fired;
+  }
+
+  WallHandle addWall(Target* target, std::chrono::milliseconds limit) {
+    std::lock_guard<std::mutex> lk(mu);
+    wall.push_back(WallEntry{target, std::chrono::steady_clock::now() + limit});
+    auto it = std::prev(wall.end());
+    cv.notify_one();
+    return it;
+  }
+  // The request's JS is running (isolate) or has stopped (null).
+  void setWallRunning(WallHandle it, v8::Isolate* isolate) {
+    std::lock_guard<std::mutex> lk(mu);
+    it->isolate = isolate;
+  }
+  void removeWall(WallHandle it) {
+    std::lock_guard<std::mutex> lk(mu);
+    wall.erase(it);
+  }
+
+ private:
+  Watchdog() {
+    thread = std::thread([this]() { run(); });
+    thread.detach();
+  }
+
+  void run() {
+    std::unique_lock<std::mutex> lk(mu);
+    for (;;) {
+      if (cpu.empty() && wall.empty()) {
+        cv.wait(lk);
+        continue;
+      }
+      auto now = std::chrono::steady_clock::now();
+      for (auto& w: wall) {
+        if (!w.fired && now >= w.deadline) {
+          w.fired = true;
+          w.target->wallExceeded();
+          if (w.isolate != nullptr) w.isolate->TerminateExecution();
+        }
+      }
+      for (auto& c: cpu) {
+        if (!c.fired && cpuNowNs(c.clock) >= c.deadlineNs) {
+          c.fired = true;
+          c.target->cpuExceeded();
+          c.isolate->TerminateExecution();
+        }
+      }
+      cv.wait_for(lk, std::chrono::milliseconds(cpu.empty() ? 10 : 1));
+    }
+  }
+
+  std::mutex mu;
+  std::condition_variable cv;
+  std::list<CpuEntry> cpu;
+  std::list<WallEntry> wall;
+  std::thread thread;
+};
+
+// ---------------------------------------------------------------------------------------------
+// State shared by the isolate enforcer and the request enforcers of one Worker.
+
+class RequestEnforcer;
+
+struct WorkerState {
+  std::string name;
+  WorkerLimits limits;
+  std::shared_ptr<CountingAllocator> allocator;
+  std::atomic<v8::Isolate*> isolate{nullptr};
+  std::atomic<uint32_t> heapHits{0};
+  // The request whose JavaScript is running on the isolate now (the isolate runs one at a time).
+  std::atomic<RequestEnforcer*> running{nullptr};
+};
+
+std::mutex registryMutex;
+std::map<std::string, std::shared_ptr<WorkerState>>& registry() {
+  static auto* r = new std::map<std::string, std::shared_ptr<WorkerState>>();
+  return *r;
+}
+
+std::shared_ptr<WorkerState> findState(kj::StringPtr name) {
+  std::lock_guard<std::mutex> lk(registryMutex);
+  auto it = registry().find(std::string(name.cStr()));
+  return it == registry().end() ? nullptr : it->second;
+}
