+// ---------------------------------------------------------------------------------------------
+// Exceptions
+
+enum class Exceeded : int { NONE = 0, CPU = 1, WALL = 2, MEMORY = 3 };
+
+kj::Exception makeExceeded(Exceeded kind) {
+  switch (kind) {
+    case Exceeded::CPU: {
+      auto e = JSG_KJ_EXCEPTION(OVERLOADED, Error, "Worker exceeded CPU time limit.");
+      e.setDetail(CPU_LIMIT_DETAIL_ID, kj::heapArray<kj::byte>(0));
+      return e;
+    }
+    case Exceeded::WALL: {
+      auto e = JSG_KJ_EXCEPTION(OVERLOADED, Error, "Worker exceeded wall-clock time limit.");
+      e.setDetail(WALL_TIME_LIMIT_DETAIL_ID, kj::heapArray<kj::byte>(0));
+      return e;
+    }
+    case Exceeded::MEMORY:
+    default: {
+      auto e = JSG_KJ_EXCEPTION(OVERLOADED, Error, "Worker exceeded memory limit.");
+      e.setDetail(MEMORY_LIMIT_DETAIL_ID, kj::heapArray<kj::byte>(0));
+      return e;
+    }
+  }
+}
+
+kj::Maybe<EventOutcome> outcomeOf(Exceeded kind) {
+  switch (kind) {
+    case Exceeded::CPU:
+      return EventOutcome::EXCEEDED_CPU;
+    case Exceeded::WALL:
+      return EventOutcome::EXCEEDED_WALL_TIME;
+    case Exceeded::MEMORY:
+      return EventOutcome::EXCEEDED_MEMORY;
+    default:
+      return kj::none;
+  }
+}
