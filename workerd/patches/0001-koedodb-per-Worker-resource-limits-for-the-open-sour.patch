+// Copyright (c) 2026 RadarWorks LLC (KoedoDB). Licensed under the Apache License, Version 2.0.
+//
+// Per-Worker resource limits for the open-source workerd server, which otherwise runs with the
+// "single-tenant policy: no limits" enforcers (NullIsolateLimitEnforcer / NullLimitEnforcer in
+// worker-factory.c++). One tenant's Worker must not be able to stop the others in the same process:
+//
+//   heapMb      V8 old-generation limit of the Worker's isolate; reaching it ends the running request
+//               (TerminateExecution on that isolate only), the process lives.
+//   externalMb  bytes of ArrayBuffer / typed array / WebAssembly memory of the isolate; an allocation
+//               over the cap fails with a RangeError instead of growing until the cgroup OOM kill.
+//   cpuMs       CPU time of one request (thread CPU clock, summed over the request's JS runs).
+//   wallMs      wall-clock time of one request (also covers awaiting an upstream that never answers).
+//   subrequests number of subrequests one request may start.
+//
+// A value of 0 means "no limit". The limits come from the environment variable
+// WORKERD_KOEDODB_LIMITS (or the file named by WORKERD_KOEDODB_LIMITS_FILE), a list of entries
+//   <worker name>|*=cpu:50,wall:5000,heap:64,ext:128,sub:50 ; <worker name>=...
+// separated by ';' or newlines; '*' is the default for workers that have no entry.
+
+#pragma once
+
+#include <workerd/io/limit-enforcer.h>
+
+#include <v8.h>
+
+#include <kj/common.h>
+#include <kj/memory.h>
+#include <kj/string.h>
+
+namespace workerd::server::koedodb {
+
+struct WorkerLimits {
+  uint32_t cpuMs = 0;
+  uint32_t wallMs = 0;
+  uint32_t heapMb = 0;
+  uint32_t externalMb = 0;
+  uint32_t subrequests = 0;
+
+  bool any() const {
+    return cpuMs || wallMs || heapMb || externalMb || subrequests;
+  }
+};
+
+// The limits of the Worker called `name` (its own entry, else the '*' entry, else none).
+WorkerLimits limitsFor(kj::StringPtr name);
+
+// The enforcer of one isolate (one Worker); none when the Worker has no limits (the caller then keeps
+// the "no limits" enforcer). Also creates the per-Worker state that the per-request enforcers made by
+// newRequestLimitEnforcer() share.
+kj::Maybe<kj::Own<IsolateLimitEnforcer>> newIsolateLimitEnforcer(
+    kj::StringPtr name, v8::IsolateGroup group);
+
+// The enforcer of one request (one IoContext) of the Worker called `name`; none when the Worker has
+// no limits.
+kj::Maybe<kj::Own<LimitEnforcer>> newRequestLimitEnforcer(kj::StringPtr name);
+
+}  // namespace workerd::server::koedodb
